# Linux 初始化与 systemd 用户服务
CONDA_ENV_NAME=nethub-campus-wiki
PYTHON_VERSION=3.12
SYSTEMD_SERVICE_PREFIX=nethub-campus-wiki

# 后端 API
API_HOST=0.0.0.0
API_PORT=3100
# systemd 部署应保持 false；仅本地开发时改为 true。
API_RELOAD=false
# 浏览器直接读取后端图片和视频的地址；分机部署示例：https://api.example.com/media
PUBLIC_MEDIA_BASE_URL=

# 前端静态服务
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3200
# 留空时使用浏览器当前访问的主机名和 API_PORT，便于局域网访问。
FRONTEND_API_BASE_URL=
CORS_ORIGINS=*

# SQLite
DATABASE_PATH=data/campus_wiki.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_BUSY_TIMEOUT_MS=5000

# 认证；初始化脚本会在留空时生成每个部署独立的随机值。
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=120

# 文件、缓存和缩略图
PHOTO_DIR_CACHE_MINUTES=5
UPLOAD_MAX_MB=50
PROJECT_PHOTO_MAX_MB=5
AVATAR_UPLOAD_MAX_MB=5
AVATAR_SIZE_PX=512
AVATAR_WEBP_QUALITY=85
DATA_IMPORT_MAX_MB=5
THUMBNAIL_MAX_WIDTH=640
THUMBNAIL_MAX_HEIGHT=640
THUMBNAIL_WEBP_QUALITY=82
THUMBNAIL_WEBP_METHOD=6
VIDEO_THUMBNAIL_TIMEOUT_SECONDS=20
RESOURCE_HOT_THROTTLE_SECONDS=5

# 私信
MESSAGE_MAX_LENGTH=2000
MESSAGE_RECALL_WINDOW_SECONDS=120
MESSAGE_RATE_PER_MINUTE=30
STREAM_TICKET_TTL_SECONDS=60

# 留言
COMMENT_MAX_LENGTH=1000
COMMENT_RATE_PER_MINUTE=10
