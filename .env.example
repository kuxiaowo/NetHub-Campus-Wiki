# Linux 初始化与 systemd 用户服务
CONDA_ENV_NAME=nethub-campus-wiki
PYTHON_VERSION=3.12
SYSTEMD_SERVICE_PREFIX=nethub-campus-wiki

# 后端 API
API_HOST=0.0.0.0
API_PORT=3100
# systemd 部署应保持 false；仅本地开发时改为 true。
API_RELOAD=false
# production 强制 R2；只有 development/test 可显式使用 local。
APP_ENV=development
MEDIA_STORAGE_BACKEND=local
# 私有 R2 Worker 网关。生产部署设置 MEDIA_STORAGE_BACKEND=r2，并通过 Secret 注入 HMAC。
R2_MEDIA_GATEWAY_URL=https://wiki-media.nethub.wiki
R2_MEDIA_HMAC_SECRET=
R2_REQUEST_TIMEOUT_SECONDS=30
R2_DIRECT_UPLOAD_MAX_MB=20
R2_MULTIPART_PART_MB=8
R2_DOWNLOAD_URL_SECONDS=90
# 仅用于仍在本机的视频本体；分机部署示例：https://api.example.com/media
PUBLIC_MEDIA_BASE_URL=

# 前端静态服务
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3200
# 留空时使用浏览器当前访问的主机名和 API_PORT，便于局域网访问。
FRONTEND_API_BASE_URL=
FRONTEND_BASE_URL=http://127.0.0.1:3200
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CORS_ORIGINS=http://127.0.0.1:3200,http://localhost:3200

# SQLite
DATABASE_PATH=data/campus_wiki.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_BUSY_TIMEOUT_MS=5000

# NetHub Accounts OIDC。客户端密钥由 Accounts 的 register-client 命令生成。
OIDC_ISSUER=https://auth.nethub.wiki
OIDC_CLIENT_ID=campus-wiki
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3100/api/auth/callback
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_ABSOLUTE_SECONDS=2592000
# 可选：逗号分隔的中央 sub。匹配者首次进入 Wiki 时获得本地管理员角色。
WIKI_ADMIN_AUTH_SUBS=

# 文件和缩略图
UPLOAD_MAX_MB=50
PROJECT_PHOTO_MAX_MB=5
AVATAR_UPLOAD_MAX_MB=5
AVATAR_SIZE_PX=512
AVATAR_WEBP_QUALITY=85
DATA_IMPORT_MAX_MB=5
THUMBNAIL_MAX_WIDTH=640
THUMBNAIL_MAX_HEIGHT=640
THUMBNAIL_WEBP_QUALITY=82
THUMBNAIL_WEBP_METHOD=6
VIDEO_THUMBNAIL_TIMEOUT_SECONDS=20
RESOURCE_HOT_THROTTLE_SECONDS=5

# 私信
MESSAGE_MAX_LENGTH=2000
MESSAGE_RECALL_WINDOW_SECONDS=120
MESSAGE_RATE_PER_MINUTE=30
STREAM_TICKET_TTL_SECONDS=60

# 留言
COMMENT_MAX_LENGTH=1000
COMMENT_RATE_PER_MINUTE=10

# Database runtime backend: sqlite (tests/local) or d1 (production gateway)
DATABASE_BACKEND=sqlite
D1_GATEWAY_URL=
D1_GATEWAY_HMAC_SECRET=
D1_REQUEST_TIMEOUT_SECONDS=15
