[Unit]
Description=NetHub %i SQLite to D1 mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nethub
Group=nethub
EnvironmentFile=/srv/nethub/secrets/%i.production.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/srv/nethub/apps/%i/current
ExecStart=/srv/nethub/venvs/%i/bin/python /srv/nethub/apps/%i/current/scripts/d1_mirror.py worker --site %i --db /srv/nethub/data/databases/%i.sqlite3
Restart=always
RestartSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/nethub/data/databases
PrivateTmp=true

[Install]
WantedBy=multi-user.target
